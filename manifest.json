{
  "manifest_version": 2,
  "description": "Marcador en vivo para partidos de Basquet Catala",
  
  "browser_specific_settings": {
    "gecko": {
      "id": "MatchOnlineStats@sergio.delgado",
      "strict_min_version": "58.0"
    }
  },
  "name": "MatchOnlineStats",
  "version": "1.3.3",
  "custom_license": "MIT License. Cualquiera puede usar este código.",

  "permissions": [
    "https://www.basquetcatala.cat/*",
    "https://streaming.optimalwayconsulting.com/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://www.basquetcatala.cat/*",
        "https://www.basquetcatala.cat/directe/*"
        ],
      "js": [
        "src/content/dom.js",
        "src/content/data.js",
        "src/content/index.js"
      ],
      "css": ["src/style.css"]
    }
  ],

  "content_security_policy": "script-src 'self'; object-src 'self'",
  
  "icons": {
    "24": "icons/icon-24.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}