{
  "manifest_version": 2,
  "description": "Marcador en vivo e importación de partidos de Basquet Catala",
  
  "browser_specific_settings": {
    "gecko": {
      "id": "MatchOnlineStats@sergio.delgado",
      "strict_min_version": "128.0"
    }
  },
  "name": "MatchOnlineStats",
  "version": "1.4.17",

  "permissions": [
    "https://www.basquetcatala.cat/*",
    "https://streaming.optimalwayconsulting.com/*",
    "https://scrapertosupabase.onrender.com/*",
    "storage",
    "tabs"
  ],

  "background": {
    "scripts": ["src/background.js"],
    "persistent": true
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.basquetcatala.cat/directe/*",
        "https://www.basquetcatala.cat/estadistica/directe/*"
      ],
      "js": ["src/content/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.basquetcatala.cat/*"],
      "js": [
        "src/content/dom.js",
        "src/content/data.js",
        "src/content/live-import.js",
        "src/content/index.js"
      ],
      "css": ["src/style.css"],
      "run_at": "document_start"
    }
  ],

  "content_security_policy": "script-src 'self'; object-src 'self'",
  
  "icons": {
    "24": "icons/icon-24.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}